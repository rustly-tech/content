{
  "format_version": 1,
  "slug": "ownership-move-or-borrow",
  "title": "Move or Borrow?",
  "summary": "A function takes a String by value when it only needs to read it. Fix E0382 without cloning.",
  "difficulty": "easy",
  "topics": [
    "ownership",
    "borrowing"
  ],
  "lifecycle": "official",
  "version": 1,
  "statement": "statement.md",
  "starter": "starter.rs",
  "reference_solution": "solution.rs",
  "starter_expect": {
    "kind": "compile_error",
    "code": "E0382"
  },
  "tests": [
    {
      "id": "public-hello-world",
      "visibility": "public",
      "stdin": "hello world\n",
      "expected_stdout": "11 hello\nhello world\n"
    },
    {
      "id": "public-single-word",
      "visibility": "public",
      "stdin": "rust\n",
      "expected_stdout": "4 rust\nrust\n"
    },
    {
      "id": "hidden-repeated-spaces",
      "visibility": "hidden",
      "stdin": "  spaced   out  \n",
      "expected_stdout": "16 spaced\n  spaced   out  \n"
    },
    {
      "id": "hidden-multibyte",
      "visibility": "hidden",
      "stdin": "crab 🦀 time\n",
      "expected_stdout": "14 crab\ncrab 🦀 time\n"
    },
    {
      "id": "hidden-long-line",
      "visibility": "hidden",
      "stdin": " tail\n",
      "expected_stdout": "505 \ tail\n"
    }
  ]
}
