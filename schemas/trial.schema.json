{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trial",
  "description": "A Trial: the judged practice unit.",
  "type": "object",
  "properties": {
    "difficulty": {
      "description": "Difficulty tier.",
      "$ref": "#/$defs/Difficulty"
    },
    "format_version": {
      "description": "Format version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "lifecycle": {
      "description": "Editorial state.",
      "$ref": "#/$defs/Lifecycle"
    },
    "limits": {
      "description": "Resource limits, if the defaults are not right for this Trial.",
      "anyOf": [
        {
          "$ref": "#/$defs/Limits"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "description": "URL slug and identifier.",
      "type": "string"
    },
    "starter": {
      "description": "Path to the starter code the editor opens with.",
      "type": "string"
    },
    "starter_expect": {
      "description": "What the starter is expected to do before the learner changes anything.",
      "$ref": "#/$defs/ExpectedOutcome"
    },
    "statement": {
      "description": "Path to the Markdown statement, relative to the Trial file.",
      "type": "string"
    },
    "summary": {
      "description": "One-sentence summary.",
      "type": "string"
    },
    "tests": {
      "description": "Public test cases. Trusted evaluation lives outside this repository.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestCase"
      }
    },
    "title": {
      "description": "Human title.",
      "type": "string"
    },
    "topics": {
      "description": "Topics.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Topic"
      }
    },
    "version": {
      "description": "Content version. Bump whenever tests or the statement change meaningfully.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "format_version",
    "slug",
    "title",
    "summary",
    "difficulty",
    "topics",
    "lifecycle",
    "version",
    "statement",
    "starter",
    "starter_expect",
    "tests"
  ],
  "$defs": {
    "Difficulty": {
      "description": "Difficulty tier, matching the control plane's vocabulary.",
      "oneOf": [
        {
          "description": "First contact with a concept.",
          "type": "string",
          "const": "intro"
        },
        {
          "description": "Routine application of one concept.",
          "type": "string",
          "const": "easy"
        },
        {
          "description": "Combines concepts or needs a non-obvious step.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "Requires real design judgement.",
          "type": "string",
          "const": "hard"
        },
        {
          "description": "Deep or adversarial.",
          "type": "string",
          "const": "expert"
        }
      ]
    },
    "ExpectedOutcome": {
      "description": "What a runnable example is expected to do when compiled.\n\nDeclaring the expectation is what makes a broken-on-purpose example testable.\nWithout it, CI cannot tell \"this example is meant to fail\" from \"this example\nis broken\", and the teaching value of a deliberate error is exactly that it\nis deliberate.",
      "oneOf": [
        {
          "description": "Compiles and runs, producing this stdout.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "runs"
            },
            "stdout": {
              "description": "Expected stdout, compared after trimming trailing whitespace.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "stdout"
          ]
        },
        {
          "description": "Compiles cleanly. Output is not asserted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "compiles"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Fails to compile with this diagnostic code, e.g. `E0382`.\n\nThis is the backbone of predict-the-error teaching.",
          "type": "object",
          "properties": {
            "code": {
              "description": "The `rustc` error code the example must produce.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "compile_error"
            }
          },
          "required": [
            "kind",
            "code"
          ]
        }
      ]
    },
    "Lifecycle": {
      "description": "Editorial state.",
      "oneOf": [
        {
          "description": "Author is still working; not published.",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "Published with a beta marker; does not count for ranking.",
          "type": "string",
          "const": "beta"
        },
        {
          "description": "Reviewed and accepted.",
          "type": "string",
          "const": "verified"
        },
        {
          "description": "Curated by maintainers as canonical for a concept.",
          "type": "string",
          "const": "official"
        }
      ]
    },
    "Limits": {
      "description": "Resource limits, mirroring the judge's.",
      "type": "object",
      "properties": {
        "fuel": {
          "description": "Abstract work bound.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "instances": {
          "description": "Maximum concurrent guest instances.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_bytes": {
          "description": "Memory limit, bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_bytes": {
          "description": "Combined stdout+stderr limit, bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "table_elements": {
          "description": "Maximum guest table elements.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "wall_ms": {
          "description": "Wall-clock limit per execution, milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "wall_ms",
        "memory_bytes",
        "output_bytes",
        "fuel",
        "table_elements",
        "instances"
      ]
    },
    "TestCase": {
      "description": "One Trial test case.",
      "type": "object",
      "properties": {
        "expected_stdout": {
          "description": "Expected stdout.",
          "type": "string"
        },
        "id": {
          "description": "Identifier, unique within the Trial.",
          "type": "string"
        },
        "stdin": {
          "description": "Bytes written to the program's stdin.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stdin",
        "expected_stdout"
      ]
    },
    "Topic": {
      "description": "A topic tag.",
      "oneOf": [
        {
          "description": "Ownership, moves, `Copy`.",
          "type": "string",
          "const": "ownership"
        },
        {
          "description": "Shared and unique borrows.",
          "type": "string",
          "const": "borrowing"
        },
        {
          "description": "Lifetimes and variance.",
          "type": "string",
          "const": "lifetimes"
        },
        {
          "description": "Traits and generics.",
          "type": "string",
          "const": "traits"
        },
        {
          "description": "Enums, pattern matching, `Option`/`Result`.",
          "type": "string",
          "const": "enums"
        },
        {
          "description": "Collections and iterators.",
          "type": "string",
          "const": "collections"
        },
        {
          "description": "Error handling.",
          "type": "string",
          "const": "errors"
        },
        {
          "description": "Concurrency and `Send`/`Sync`.",
          "type": "string",
          "const": "concurrency"
        },
        {
          "description": "Unsafe and FFI.",
          "type": "string",
          "const": "unsafe"
        },
        {
          "description": "Modules, crates, Cargo.",
          "type": "string",
          "const": "tooling"
        }
      ]
    }
  }
}
