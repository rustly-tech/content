{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningPath",
  "description": "A learning path: an ordered sequence of lessons.",
  "type": "object",
  "properties": {
    "format_version": {
      "description": "Format version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "description": "Stable identifier, e.g. `ownership`.",
      "type": "string"
    },
    "lessons": {
      "description": "Lesson ids, in teaching order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "description": "Editorial state.",
      "$ref": "#/$defs/Lifecycle"
    },
    "prerequisites": {
      "description": "Paths a learner should complete first.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "description": "One-sentence summary shown on the Learn index.",
      "type": "string"
    },
    "title": {
      "description": "Human title.",
      "type": "string"
    },
    "topics": {
      "description": "Topics this path covers.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Topic"
      }
    }
  },
  "required": [
    "format_version",
    "id",
    "title",
    "summary",
    "topics",
    "lifecycle",
    "lessons"
  ],
  "$defs": {
    "Lifecycle": {
      "description": "Editorial state.",
      "oneOf": [
        {
          "description": "Author is still working; not published.",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "Published with a beta marker; does not count for ranking.",
          "type": "string",
          "const": "beta"
        },
        {
          "description": "Reviewed and accepted.",
          "type": "string",
          "const": "verified"
        },
        {
          "description": "Curated by maintainers as canonical for a concept.",
          "type": "string",
          "const": "official"
        }
      ]
    },
    "Topic": {
      "description": "A topic tag.",
      "oneOf": [
        {
          "description": "Ownership, moves, `Copy`.",
          "type": "string",
          "const": "ownership"
        },
        {
          "description": "Shared and unique borrows.",
          "type": "string",
          "const": "borrowing"
        },
        {
          "description": "Lifetimes and variance.",
          "type": "string",
          "const": "lifetimes"
        },
        {
          "description": "Traits and generics.",
          "type": "string",
          "const": "traits"
        },
        {
          "description": "Enums, pattern matching, `Option`/`Result`.",
          "type": "string",
          "const": "enums"
        },
        {
          "description": "Collections and iterators.",
          "type": "string",
          "const": "collections"
        },
        {
          "description": "Error handling.",
          "type": "string",
          "const": "errors"
        },
        {
          "description": "Concurrency and `Send`/`Sync`.",
          "type": "string",
          "const": "concurrency"
        },
        {
          "description": "Unsafe and FFI.",
          "type": "string",
          "const": "unsafe"
        },
        {
          "description": "Modules, crates, Cargo.",
          "type": "string",
          "const": "tooling"
        }
      ]
    }
  }
}
